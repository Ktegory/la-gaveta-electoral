---
import { HUB } from '../lib/guias';
import '../styles/global.css';
import Fuentes from '../components/Fuentes.astro';
import Iconos from '../components/Iconos.astro';
import Icono from '../components/Icono.astro';
import Marquesina from '../components/Marquesina.astro';
import Logo from '../components/Logo.astro';
import { datos } from '../lib/datos';
import { CALENDARIO, MOMENTO_PREVIA, faseAl, type Fase } from '../lib/fases';

interface Props { titulo?: string; descripcion?: string; seccion?: 'mapa' | 'partidos' | 'comparar' | 'escala' | 'metodo' | 'buscar' | 'fuentes' | 'novedades' | 'guias'; estilo?: string; indexar?: boolean; noindex?: boolean; fase?: Fase }
const { titulo, descripcion = 'Los programas de los partidos para las elecciones generales del 29N, ordenados por temas, comparables y con la fuente original al lado de cada propuesta.', seccion, estilo, indexar = true, noindex = false, fase } = Astro.props;
// Fase de la web (ver lib/fases.ts). `fase` solo la fuerzan las vistas previas de /fases/ en local.
const faseInicial = fase ?? faseAl(new Date());
const desarrollo = import.meta.env.DEV;
const nombre = 'La Gaveta electoral';
const t = titulo ? `${titulo} · ${nombre}` : `${nombre} · Elecciones generales 29N`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagen = new URL('/og.png', Astro.site);
// Datos estructurados (schema.org) solo en portada: qué es la web y cómo se busca en ella.
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: nombre,
  url: new URL('/', Astro.site).href,
  inLanguage: 'es',
  description: descripcion,
  potentialAction: { '@type': 'SearchAction', target: new URL('/buscar/?q={search_term_string}', Astro.site).href, 'query-input': 'required name=search_term_string' },
};
const NAV = [
  { id: 'partidos', href: '/partidos/', txt: 'Partidos' },
  { id: 'comparar', href: '/comparar/', txt: 'Comparar' },
  { id: 'guias', href: HUB.href, txt: HUB.nombre },
  { id: 'novedades', href: '/novedades/', txt: 'Novedades' },
  { id: 'metodo', href: '/como-funciona/', txt: 'Cómo funciona' },
] as const;
const cur = (id: string) => (seccion === id ? 'page' : undefined);
// Analítica sin cookies (Umami Cloud), solo en la web publicada: ni en local ni en /revisar/.
// data-domains evita contar las vistas previas de Netlify; data-do-not-track respeta esa opción del navegador.
const UMAMI_ID = 'bc00adce-6467-4a51-86dd-a5e9f7ab304f';
const analitica = import.meta.env.PROD;
// Cuántas novedades hay publicadas (cada propuesta nueva cuenta una). Sirve para marcar
// «Novedades» en el menú cuando hay alguna desde la última vez que se visitó esa página.
const nNovedades = (await datos()).cambios.reduce((n, c) => n + Math.max(1, c.data.propuestas?.length ?? 0), 0);

---
<!doctype html>
<html lang="es" data-fase={faseInicial} data-fase-forzada={fase ? '' : undefined} data-ahora={fase ? MOMENTO_PREVIA[fase] : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline define:vars={{ CAL: CALENDARIO, desarrollo }}>
    // Fase según la hora de Madrid, antes de pintar (así no parpadea). La cuenta atrás la vuelve a pedir cada segundo.
    // En local, ?hoy=AAAA-MM-DD o ?hoy=AAAA-MM-DDTHH:MM simula otro momento.
    window.faseGaveta = () => {
      const h = document.documentElement;
      let ahora = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Madrid', dateStyle: 'short', timeStyle: 'short' }).format(new Date()).replace(' ', 'T');
      const q = desarrollo ? new URLSearchParams(location.search).get('hoy') : null;
      if (q) { ahora = q.length === 10 ? `${q}T12:00` : q; h.dataset.ahora ??= new Date(`${ahora}:00+01:00`).toISOString(); }
      const [dia, hora] = ahora.split('T');
      if (!h.hasAttribute('data-fase-forzada')) {
        const antes = h.dataset.fase;
        h.dataset.fase = dia < CAL.reflexion ? 'campana' : dia === CAL.reflexion ? 'reflexion'
          : dia === CAL.votacion ? (hora < CAL.cierre ? 'votacion' : 'escrutinio') : 'despues';
        h.toggleAttribute('data-veda', dia >= CAL.vedaDesde && dia <= CAL.reflexion);
        if (antes !== h.dataset.fase && document.readyState !== 'loading') window.activarFases();
      }
      return h.dataset.fase;
    };
    // Lo de otras fases llega dentro de <template> (components/portada/Solo.astro): se saca cuando toca.
    // En bucle, porque al sacar uno pueden aparecer otros dentro.
    window.activarFases = () => {
      const f = document.documentElement.dataset.fase;
      for (let hay = true; hay;) {
        hay = false;
        for (const t of document.querySelectorAll('template[data-fase-tpl]:not([data-hecho])')) {
          if (!t.dataset.faseTpl.split(' ').includes(f)) continue;
          t.before(t.content.cloneNode(true));
          t.dataset.hecho = '';
          hay = true;
        }
      }
    };
    window.faseGaveta();
    document.addEventListener('DOMContentLoaded', () => window.activarFases());
  </script>
  <Fuentes />
  {Astro.url.pathname === '/' && <link rel="preload" as="image" href="/img/hero-mano.webp" type="image/webp" fetchpriority="high" />}
  <title>{t}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonica} />
  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="alternate" type="application/rss+xml" title="La Gaveta electoral · Novedades" href="/novedades.xml" />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#FFFFFF" />
  <meta property="og:site_name" content={nombre} />
  <meta property="og:title" content={t} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonica} />
  <meta property="og:image" content={imagen} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="La Gaveta electoral: los programas del 29N, ordenados por temas y con su fuente." />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />}
  <meta property="og:locale" content="es_ES" />
  <meta name="theme-color" content="#0E0E0E" />
  {analitica && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={UMAMI_ID} data-domains="lagavetaelectoral.org" data-do-not-track="true"></script>}
</head>
<body>
<Iconos />
<div class="site" style={estilo}>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <header class="hdr pad">
    <Logo />
    <nav class="nav" aria-label="Principal">
      {NAV.map((n) => <a href={n.href} aria-current={cur(n.id)}>{n.txt}{n.id === 'novedades' && <span class="nov-punto" hidden><span class="sr-only"> (hay novedades)</span></span>}</a>)}
    </nav>
    <a class="search" href="/buscar/" aria-label="Buscar una propuesta" title="Buscar una propuesta" aria-current={cur('buscar')}><Icono id="search" /></a>
    <details class="menu">
      <summary aria-label="Menú"><svg class="hamb" viewBox="0 0 18 14" aria-hidden="true"><path d="M1 1h16M1 7h16M1 13h16" /></svg><span class="nov-punto" hidden></span></summary>
      <nav aria-label="Menú">
        {NAV.map((n) => <a href={n.href} aria-current={cur(n.id)}>{n.txt}{n.id === 'novedades' && <span class="nov-punto" hidden><span class="sr-only"> (hay novedades)</span></span>}</a>)}
        <a href="/fuentes/" aria-current={cur('fuentes')}>Fuentes</a>
        <a href="/buscar/" aria-current={cur('buscar')}>Buscar</a>
      </nav>
    </details>
  </header>
  <script is:inline>
    // Altura real de la cabecera fija, para colocar debajo las demás piezas fijas.
    (() => {
      const h = document.querySelector('.hdr');
      if (!h) return;
      const medir = () => document.documentElement.style.setProperty('--hdr-h', `${h.offsetHeight}px`);
      medir();
      if ('ResizeObserver' in window) new ResizeObserver(medir).observe(h);
    })();
  </script>
  <script is:inline define:vars={{ nNovedades }}>
    // Punto en «Novedades» si se ha publicado algo desde la última visita a esa página.
    // En la primera visita a la web no se marca nada: solo cuenta lo que llegue después.
    (() => {
      let vistas = null;
      try { vistas = localStorage.getItem('novedades-vistas'); } catch (e) {}
      const guardar = () => { try { localStorage.setItem('novedades-vistas', String(nNovedades)); } catch (e) {} };
      if (vistas === null || location.pathname.startsWith('/novedades')) return guardar();
      if (!(nNovedades > Number(vistas))) return;
      document.querySelectorAll('.nov-punto').forEach((p) => { p.hidden = false; });
      document.querySelector('.menu summary')?.setAttribute('aria-label', 'Menú (hay novedades)');
    })();
  </script>
  <Marquesina />
  <main id="contenido" data-pagefind-body={indexar ? '' : undefined}>
    <slot />
  </main>
  <footer class="foot pad">
    <div class="foot-id"><Logo /><span>Una iniciativa civil · Sin vinculación con ningún partido.</span><span class="foot-autor">Diseño y desarrollo: <a href="https://khiustin.com/" rel="author noopener" target="_blank">Khiustin Tornés</a></span></div>
    <nav aria-label="Pie"><a href="/como-funciona/" aria-current={cur('metodo')}>Cómo funciona</a><a href="/fuentes/" aria-current={cur('fuentes')}>Fuentes</a><a href="/como-funciona/#errores">¿Has visto un error?</a><a href="/novedades/" aria-current={cur('novedades')}>Novedades</a><a class="foot-rss" href="/novedades.xml" type="application/rss+xml" aria-label="RSS de las novedades" title="RSS de las novedades"><Icono id="rss" class="rss" /></a></nav>
  </footer>
  <nav class="tabbar" aria-label="Accesos rápidos">
    <a href="/partidos/" aria-current={cur('partidos')}><Icono id="home" />Partidos</a>
    <a href="/comparar/" aria-current={cur('comparar')}><Icono id="cols" />Comparar</a>
    <a href="/buscar/" aria-current={cur('buscar')}><Icono id="search" />Buscar</a>
  </nav>
</div>
{analitica && (
  <script is:inline>
    // Eventos anónimos para Umami: qué fuentes se abren, qué se busca y si se usa el simulador.
    (() => {
      const ev = (n, d) => window.umami?.track(n, d);
      document.addEventListener('click', (e) => {
        const a = e.target.closest?.('a[href^="http"]');
        if (!a || a.host === location.host || a.relList.contains('author')) return;
        ev('fuente', { dominio: a.host.replace(/^www\./, '') });
      });
      const caja = document.getElementById('buscador');
      if (caja) {
        let t, ultima = '';
        caja.addEventListener('input', (e) => {
          clearTimeout(t);
          t = setTimeout(() => {
            const q = (e.target.value || '').trim().toLowerCase().slice(0, 60);
            if (q.length < 3 || q === ultima) return;
            ultima = q;
            ev('busqueda', { q, resultados: caja.querySelectorAll('.pagefind-ui__result').length });
          }, 2000);
        });
      }
      const sim = document.querySelector('[data-sim]');
      if (sim) {
        const una = () => { ev('simulador'); sim.removeEventListener('input', una); sim.removeEventListener('change', una); };
        sim.addEventListener('input', una);
        sim.addEventListener('change', una);
      }
    })();
  </script>
)}
</body>
</html>
