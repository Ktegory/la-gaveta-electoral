---
// Logo de La Gaveta (src/assets/logo.svg). Toma el color del texto que lo rodea
// (fill="currentColor"), así que vale igual en la cabecera (tinta) y en el pie (blanco).
import Svg from '../assets/logo.svg';
interface Props { class?: string }
const { class: clase } = Astro.props;
---
<a class:list={['logo', clase]} href="/" aria-label="La Gaveta electoral, inicio"><Svg aria-hidden="true" focusable="false" /></a>
