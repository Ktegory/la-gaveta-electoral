---
// Marquesina de lo provisional. Se genera con los datos: un mensaje por partido (orden alfabético).
import { datos, varsPartido, TITULAR_ESTADO, detalleEstado } from '../lib/datos';
import IconoEstado from './IconoEstado.astro';
const d = await datos();
const sinPrograma = d.partidos.filter((p) => p.data.estadoPrograma !== 'publicado').length;
const general =
  sinPrograma === d.partidos.length
    ? 'Ningún partido ha publicado aún su <b>programa completo</b> para el 29N'
    : `<b>${sinPrograma} de ${d.partidos.length} partidos</b> aún no han publicado su programa completo para el 29N`;
const items = [
  { p: null, t: general },
  ...d.partidos.map((p) => ({ p, t: detalleEstado(d, p) })),
  { p: null, t: 'Lo marcado con línea discontinua es <b>provisional</b>' },
];
const resumen = `${general.replace(/<[^>]+>/g, '')}. ${d.partidos.map((p) => `${p.data.nombre}: ${TITULAR_ESTADO[p.data.estadoPrograma].toLowerCase()} (${detalleEstado(d, p)})`).join('. ')}.`;
// Huella del contenido: si alguien cierra la marquesina, vuelve a salir cuando cambie lo que dice
// (por ejemplo, cuando un partido publique su programa).
let h = 0;
for (const c of resumen) h = (h * 31 + c.charCodeAt(0)) | 0;
const huella = (h >>> 0).toString(36);
---
<div class="prov pad" role="region" aria-label="Aviso: información provisional" data-huella={huella}>
  <span class="k">PROVISIONAL</span>
  <div class="mq">
    <p class="sr">{resumen}</p>
    <div class="mq-track" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="mq-set">
          {items.map(({ p, t }) => (
            <span>
              {p && (
                <span class={`mq-logo l-${p.id} ${p.data.logo ? '' : 'fb'}`} style={varsPartido(p)}>
                  {p.data.logo && <img src={p.data.logo.archivo} alt="" fetchpriority="low" decoding="async" onerror="this.parentNode.classList.add('fb');this.remove()" />}
                  <em>{p.data.siglas}</em>
                </span>
              )}
              {p ? (
                <span class="mq-est"><IconoEstado estado={p.data.estadoPrograma} /><b>{TITULAR_ESTADO[p.data.estadoPrograma]}</b><span class="mq-det">{t}</span></span>
              ) : <span set:html={t} />}
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
  <button class="mq-cerrar" type="button" aria-label="Ocultar el aviso de información provisional" title="Ocultar">×</button>
</div>
<script is:inline>
  // En línea, justo después de la marquesina, para que actúe antes de pintar:
  // así sigue donde estaba en la página anterior (y la transición no da un salto).
  // Se para al pasar el cursor por encima (CSS) y se puede cerrar con la ×.
  (function () {
    var prov = document.querySelector('.prov');
    // Cerrada por la persona: no se muestra hasta que cambie su contenido.
    function leerL(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
    function guardarL(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
    if (prov && leerL('mq-cerrada') === prov.dataset.huella) { prov.hidden = true; return; }
    var x = prov && prov.querySelector('.mq-cerrar');
    if (x) x.addEventListener('click', function () {
      guardarL('mq-cerrada', prov.dataset.huella);
      var quieto = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (quieto) { prov.hidden = true; return; }
      prov.classList.add('cerrando');
      setTimeout(function () { prov.hidden = true; }, 300);
    });
    var track = prov && prov.querySelector('.mq-track');
    if (!track) return;
    function leer(k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } }
    function guardar(k, v) { try { sessionStorage.setItem(k, v); } catch (e) {} }
    var anim = track.getAnimations ? track.getAnimations()[0] : null;
    var t = leer('mq-t'), en = leer('mq-en');
    var donde = Number(t) + Date.now() - Number(en);
    if (anim && t !== null && en !== null && isFinite(donde)) anim.currentTime = donde;
    addEventListener('pagehide', function () {
      if (!anim || anim.currentTime === null) return;
      guardar('mq-t', String(anim.currentTime));
      guardar('mq-en', String(Date.now()));
    });
  })();
</script>
