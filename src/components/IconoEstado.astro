---
// Icono del estado del programa. El mismo en toda la web:
// publicado = círculo lleno con check · avance = círculo discontinuo medio lleno · sin publicar = círculo discontinuo vacío.
import type { ESTADO } from '../lib/datos';
interface Props { estado: keyof typeof ESTADO }
const { estado } = Astro.props;
---
<svg class={`ie ${estado}`} viewBox="0 0 16 16" aria-hidden="true">
  {estado === 'publicado' ? (
    <><circle class="ie-f" cx="8" cy="8" r="7.25" /><path class="ie-ok" d="M4.75 8.25l2.25 2.25 4.25-5" /></>
  ) : (
    <><circle class="ie-c" cx="8" cy="8" r="6.5" />{estado === 'avance' && <path class="ie-f" d="M8 1.5a6.5 6.5 0 0 0 0 13z" />}</>
  )}
</svg>
