  .gr-crumbs { margin-bottom: clamp(28px, 2.6cqi, 44px) }
  .gr { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sec-s); padding-bottom: var(--sec) }
  .gr a { color: var(--ink); text-underline-offset: 3px }
  :global(:root:has(.gr-pasos)) { scroll-padding-top: calc(var(--hdr-h) + var(--pasos-h, 56px) - 1px) }

  /* Cifras: número grande y la palabra clave al lado */
  .gr-cifras { display: grid; gap: 8px 32px; grid-template-columns: 1fr }
  @container site (min-width: 640px) { .gr-cifras { grid-template-columns: 1fr 1fr } }
  @container site (min-width: 1100px) { .gr-cifras { grid-template-columns: repeat(4, 1fr) } }
