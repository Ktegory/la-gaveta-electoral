  .gr-c { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 10px; margin: 0 }
  .gr-c b { font-size: clamp(3.5rem, 6cqi, 5.5rem); line-height: .85; font-weight: 800 }
  .gr-c strong { font-size: clamp(1.5rem, 2.2cqi, 2rem); line-height: 1; font-weight: 800; text-transform: uppercase; color: var(--ink) }
  .gr-cifras span { font-size: 1rem; line-height: 1.35; color: var(--ink2) }
  .gr-cifras a { margin-top: auto; padding-top: 8px; font-size: .8125rem; color: var(--mute) }

  /* Barra de pasos: del voto a la investidura, con flechas; se queda fija al bajar */
  .gr-pasos { position: sticky; top: var(--hdr-h); z-index: 3; margin-bottom: calc(var(--sec-s) * -.5); padding: 12px 0; background: var(--bg); border-bottom: 1px solid transparent; overflow-x: auto; scrollbar-width: none }
  /* Fija arriba: fondo y filete de lado a lado de la pantalla, no solo del ancho del contenido. */
  .gr-pasos.pegada { box-shadow: 0 0 0 100vmax var(--bg); clip-path: inset(0 -100vmax); border-image: linear-gradient(var(--hair), var(--hair)) 0 0 1 0 / 0 0 1px 0 / 0 100vmax }
  .gr-pasos ol { display: flex; align-items: center; width: max-content; margin: 0; padding: 0; list-style: none }
  .gr-pasos li { display: flex; align-items: center; flex: none }
  .gr-pasos li:not(:first-child, .gr-pasos-y) { position: relative }
  .gr-pasos li:not(:first-child, .gr-pasos-y)::before { content: ""; width: clamp(16px, 3cqi, 48px); height: 2px; margin: 0 6px; background: var(--tost2) }
  .gr-pasos li:not(:first-child, .gr-pasos-y)::after { content: ""; position: absolute; left: calc(clamp(16px, 3cqi, 48px) + 1px); top: 50%; width: 7px; height: 7px; border-top: 2px solid var(--tost2); border-right: 2px solid var(--tost2); transform: translate(-2px, -50%) rotate(45deg) }
  .gr-pasos .gr-pasos-y { margin-left: 12px; padding-left: 12px; border-left: 1px solid var(--crema-filete) }
  .gr-pasos a { display: inline-flex; align-items: center; gap: 8px; height: var(--h-ctl); padding: 0 14px 0 6px; border-radius: 999px; background: var(--crema); color: var(--ink); font-size: .9375rem; font-weight: 700; text-decoration: none; white-space: nowrap; transition: background-color .2s ease }
  .gr-pasos a:hover { background: var(--crema-hover) }
  .gr-pasos a span { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: #fff; font-family: var(--mono); font-size: .8125rem; font-weight: 500 }
  .gr-pasos a[aria-current] { background: var(--tost) }

  /* Secciones: número a la izquierda del título */
  .gr-sec { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; padding-top: 32px; border-top: 1px solid var(--hair) }
  .gr-h { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 clamp(14px, 1.6cqi, 24px); align-items: start; max-width: 80ch }
  .gr-h .gr-paso { display: grid; place-items: center; width: clamp(44px, 4cqi, 60px); aspect-ratio: 1; margin: 0; border-radius: 50%; background: var(--tost); color: var(--ink); font-family: var(--cond); font-size: clamp(1.75rem, 2.6cqi, 2.375rem); font-weight: 800; line-height: 1 }
  .gr-h .gr-paso-y { background: transparent; box-shadow: inset 0 0 0 2px var(--tost2) }
  .gr-h h2 { margin: 0 0 12px; font-size: clamp(2.25rem, 4cqi, 3.5rem); line-height: .95; text-transform: uppercase; padding-top: clamp(4px, .5cqi, 8px) }
  .gr-h p { margin: 0; font-size: 1.0625rem; line-height: 1.5; color: var(--ink2) }
  .gr-nota { margin: 0; font-size: .875rem; line-height: 1.45; color: var(--mute); max-width: 90ch }
  .gr-nota a { color: var(--mute) }

  /* Provincias: mapa de casillas o lista */
  .gr-prov-bar { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; margin-bottom: 24px }
  .gr-prov-bar h3 { margin: 0; font-size: 1.125rem }
  /* Mismo selector que la vista de Comparar (.vista, en global.css); el foco, dentro de la píldora. */
  .gr-vista button:focus-visible { outline: 2px solid var(--ink); outline-offset: -2px; box-shadow: none }
  /* Al cambiar de mapa a lista (o al revés), lo nuevo aparece con un fundido. */
  .gr-prov.cambiada [data-panel]:not([hidden]) { animation: gr-fundido .25s ease }
  @keyframes gr-fundido { from { opacity: 0 } }
  @media (prefers-reduced-motion: reduce) { .gr-prov.cambiada [data-panel]:not([hidden]) { animation: none } }
  .gr-prov [data-panel][hidden] { display: none }
  .gr-mapa-w { display: grid; gap: 12px; container: mapa / inline-size }
  .gr-mapa { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); grid-template-rows: repeat(9, auto); gap: 4px; max-width: 840px; margin: 0; padding: 0; list-style: none }
  .gr-mapa li { display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 1; min-width: 0; padding: 6px 7px; border-radius: 8px; background: var(--crema) }
  .gr-mn { font-size: .6875rem; line-height: 1.1; font-weight: 600; color: var(--ink2); hyphens: auto }
  .gr-mapa b { align-self: flex-end; font-size: clamp(1.25rem, 3.4cqi, 2.25rem); font-weight: 800; line-height: .85 }
  @container mapa (max-width: 600px) {
    .gr-mapa { gap: 2px }
    .gr-mapa li { justify-content: center; align-items: center; padding: 0; border-radius: 4px }
    .gr-mn { display: none }
    .gr-mapa b { align-self: center; font-size: 1rem }
  }
  .t0 { background: var(--crema) !important }
  .t1 { background: var(--tost) !important }
  .t2 { background: var(--tost2) !important }
  .t3 { background: var(--tost3) !important; color: #fff }
  .t4 { background: var(--tost4) !important; color: #fff }
  .gr-mapa .t3 .gr-mn, .gr-mapa .t4 .gr-mn { color: #fff }
  .gr-ley { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0; padding: 0; list-style: none; font-size: .8125rem; color: var(--ink2) }
  .gr-ley li { display: inline-flex; align-items: center; gap: 6px }
  .gr-ley i { width: 14px; height: 14px; border-radius: 3px }
  .gr-lista { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hair2) }
  .gr-lista li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 4px 16px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--hair2) }
  @container site (min-width: 900px) { .gr-lista li { grid-template-columns: 3rem minmax(0, 23rem) minmax(0, 1fr) } }
  .gr-n { grid-row: span 2; font-size: 2rem; font-weight: 800; line-height: 1; text-align: right }
  @container site (min-width: 900px) { .gr-n { grid-row: auto } }
  .gr-dots { display: flex; flex-wrap: wrap; gap: 3px }
  .gr-dots i { width: 9px; height: 9px; border-radius: 2px; background: var(--tost2) }
  .gr-sitios { font-size: .9375rem; line-height: 1.4; color: var(--ink2) }

  /* Simulador */
  .sim { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; padding: clamp(16px, 2cqi, 28px); border-radius: var(--r-card); background: var(--crema) }
  @container site (min-width: 1000px) { .sim { grid-template-columns: minmax(300px, 25rem) minmax(0, 1fr); align-items: start } }
  .sim-ctl { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; min-width: 0 }
  @container site (min-width: 1000px) { .sim-ctl { position: sticky; top: calc(var(--hdr-h) + var(--pasos-h, 56px) + 16px) } }
  .sim-esc { display: grid; gap: 6px; font-size: .875rem; font-weight: 700 }
  .sim-esc select { width: 100%; min-width: 0; height: var(--h-ctl); padding: 0 12px; border: 1.5px solid var(--tost2); border-radius: 10px; background: #fff; font: inherit; font-weight: 600; font-size: .9375rem }
  .sim fieldset { display: grid; min-width: 0; gap: 8px; margin: 0; padding: 0; border: 0 }
  .sim legend { margin-bottom: 8px; padding: 0; font-size: .875rem; font-weight: 700 }
  .sim-fila { display: grid; grid-template-columns: 28px minmax(0, 1fr) 7.5rem; gap: 10px; align-items: center }
  .sim-fila input[type="range"] { width: 100%; accent-color: var(--tost3) }
  .sim-fila input[type="number"] { width: 100%; height: 36px; padding: 0 8px; border: 1px solid var(--crema-filete); border-radius: 8px; background: #fff; font: inherit; font-size: .9375rem; font-variant-numeric: tabular-nums; text-align: right }
  .sim-blanco { margin-top: 4px; padding-top: 10px; border-top: 1px solid var(--crema-filete) }
  .sim-bl { font-size: .875rem; color: var(--ink2) }
  .sim-reset { justify-self: start; height: 36px; padding: 0 14px; border: 1.5px solid var(--tost3); border-radius: 999px; background: transparent; font: inherit; font-size: .875rem; font-weight: 700; cursor: pointer }
  .sim-reset:hover { background: var(--tost) }

  /* Fichas de candidatura: letra y tono tostado (sin colores de partido, porque son inventadas) */
  .sim :global(.sim-l) { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 6px; font-family: var(--mono); font-size: .875rem; font-weight: 500 }
  .sim :global(.p0) { background: #5A4A24; color: #fff }
  .sim :global(.p1) { background: #8C7646; color: #fff }
  .sim :global(.p2) { background: #B9A26C; color: var(--ink) }
  .sim :global(.p3) { background: #DCCB98; color: var(--ink) }
  .sim :global(.p4) { background: #fff; color: var(--ink); box-shadow: inset 0 0 0 1.5px #8C7646 }
  .sim :global(.p5) { background: repeating-linear-gradient(135deg, #fff 0 4px, #DCCB98 4px 6px); color: var(--ink); box-shadow: inset 0 0 0 1.5px #8C7646 }
  .sim :global(.pb) { background: #fff; outline: 1.5px dashed var(--mute); outline-offset: -1.5px }

  .sim-out { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; min-width: 0 }
  .sim-paso { padding: 18px 20px; border-radius: var(--r-in); background: #fff }
  .sim-paso h3 { display: flex; align-items: center; gap: 10px; margin: 0 0 10px; font-size: 1.125rem }
  .sim-paso h3 span { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--tost); font-family: var(--mono); font-size: .8125rem; font-weight: 500 }
  .sim-paso p { margin: 0 0 12px; font-size: .9375rem; line-height: 1.45; color: var(--ink2) }

  .sim-umbral { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none }
  .sim-umbral :global(li) { display: grid; grid-template-columns: 28px minmax(0, 1fr) 7.5rem; gap: 10px; align-items: center }
  .sim-umbral :global(li.fuera) { opacity: .55 }
  .sim-umbral :global(.sim-bar) { position: relative; height: 14px; border-radius: 4px; background: var(--hair2) }
  .sim-umbral :global(.sim-bar i) { position: absolute; inset: 0 auto 0 0; border-radius: 4px }
  .sim-umbral :global(.sim-bar em) { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background: var(--ink); outline: 2px solid #fff }
  .sim-umbral :global(.sim-v) { font-size: .875rem; font-variant-numeric: tabular-nums; text-align: right; line-height: 1.2 }
  .sim-umbral :global(.sim-v small) { display: block; font-size: .75rem; color: var(--mute) }

  .sim-tabla-w { overflow-x: auto; margin: 0 -4px; padding: 4px }
  .sim-tabla { border-collapse: separate; border-spacing: 3px; font-size: .8125rem; font-variant-numeric: tabular-nums }
  .sim-tabla :global(th) { padding: 4px 6px; font-family: var(--mono); font-weight: 400; color: var(--mute) }
  .sim-tabla :global(thead th:not(:first-child))::before { content: "÷" }
  .sim-tabla :global(tbody th) { position: sticky; left: 0; background: #fff }
  .sim-tabla :global(td) { position: relative; min-width: 4.5rem; padding: 14px 8px 6px; border-radius: 6px; background: var(--hair2); text-align: right; color: var(--mute) }
  .sim-tabla :global(td.gana) { background: var(--tost); color: var(--ink); font-weight: 700 }
  .sim-tabla :global(td sup) { position: absolute; top: 3px; left: 6px; font-family: var(--mono); font-size: .6875rem; font-weight: 400; color: var(--tost4) }
  .sim-tabla :global(td.ult) { box-shadow: inset 0 0 0 2px var(--tost4) }
  .sim-tabla :global(td.riv) { background: #fff; color: var(--ink); font-weight: 700; outline: 2px dashed var(--tost4); outline-offset: -2px }

  .sim-esc-res { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px }
  .sim-esc-res :global(.ult) { outline: 2px solid var(--tost4); outline-offset: 2px }
  .sim-resumen { font-size: 1rem !important; color: var(--ink) !important }
  .sim-ultimo { padding: 14px 16px; border-radius: 10px; background: var(--crema) }
  .sim-ultimo :global(p) { margin: 0; font-size: .9375rem; line-height: 1.45; color: var(--ink) }
  .sim-ultimo :global(p + p) { margin-top: 8px }

  /* Tres tarjetas */
  .gr-tres { display: grid; gap: 16px 32px }
  @container site (min-width: 800px) { .gr-tres { grid-template-columns: repeat(3, 1fr) } }
  .gr-tres > div { padding: 20px 22px; border-radius: var(--r-in); background: var(--crema) }
  .gr-tres h3 { display: flex; align-items: center; gap: 12px; margin: 0 0 12px; font-size: 1.125rem }
  .gr-ico { display: grid; place-items: center; flex: none; width: 48px; height: 48px; border-radius: 50%; background: #fff; font-size: 1.75rem }
  .gr-tres p { margin: 0 0 10px; font-size: .9375rem; line-height: 1.45; color: var(--ink2) }
  .gr-tres p:last-child { margin: 0 }
  .gr-ef { font-weight: 700; color: var(--ink) !important }

  /* Línea temporal */
  .gr-linea { display: grid; gap: 0; margin: 0; padding: 0; list-style: none }
  .gr-linea li { position: relative; display: grid; align-content: start; gap: 4px; padding: 0 0 24px 40px }
  .gr-linea li::before { content: ""; position: absolute; left: 9px; top: 6px; width: 14px; height: 14px; border-radius: 50%; background: var(--tost2) }
  .gr-linea li:not(:last-child)::after { content: ""; position: absolute; left: 15px; top: 28px; bottom: 2px; width: 2px; background: var(--tost) }
  .gr-linea b { font-size: 1.125rem }
  .gr-linea span { font-size: .9375rem; line-height: 1.45; color: var(--ink2); max-width: 70ch }
  .gr-linea a { font-size: .8125rem; color: var(--mute) }
  @container site (min-width: 1000px) {
    .gr-linea { grid-template-columns: repeat(5, 1fr); gap: 24px }
    .gr-linea li { padding: 36px 0 0 }
    .gr-linea li::before { left: 0; top: 0 }
    .gr-linea li:not(:last-child)::after { left: 22px; right: -16px; top: 6px; bottom: auto; width: auto; height: 2px }
  }

  .gr-fuentes { padding-top: 24px; border-top: 1px solid var(--hair); font-size: .875rem; color: var(--ink2) }
  .gr-fuentes h2 { margin: 0 0 10px; font-size: 1rem }
  .gr-fuentes ul { margin: 0 0 10px; padding-left: 18px; line-height: 1.5 }
  .gr-fuentes p { margin: 0; color: var(--mute) }
</style>
