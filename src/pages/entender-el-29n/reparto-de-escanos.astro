---
// Guía: cómo se reparten los 350 escaños del Congreso (y lo básico del Senado y la investidura).
// Todo sale del BOE: el anexo del decreto de convocatoria y los artículos de la LOREG y la Constitución que se citan.
// El simulador usa candidaturas inventadas (A, B, C…): explica el método, no predice nada.
import Base from '../../layouts/Base.astro';
import { CIRCUNSCRIPCIONES, RD_CONVOCATORIA } from '../../lib/guias/circunscripciones';
import { HUB } from '../../lib/guias';
import Icono from '../../components/Icono.astro';

const total = CIRCUNSCRIPCIONES.reduce((n, c) => n + c.diputados, 0);
if (total !== 350 || CIRCUNSCRIPCIONES.length !== 52) throw new Error(`Circunscripciones: ${CIRCUNSCRIPCIONES.length}, diputados: ${total}`);
// «Coruña (A)» → «A Coruña», como se dice al hablar.
const nombre = (n: string) => n.replace(/^(.*) \((.*)\)$/, '$2 $1');
// Provincias agrupadas por número de diputados, de más a menos (vista de lista).
const grupos = [...new Set(CIRCUNSCRIPCIONES.map((c) => c.diputados))]
  .sort((a, b) => b - a)
  .map((n) => ({ n, sitios: CIRCUNSCRIPCIONES.filter((c) => c.diputados === n).map((c) => nombre(c.nombre)) }));
// Tono de cada casilla del mapa según los diputados que elige.
const TRAMOS = [
  { hasta: 2, txt: '1-2' },
  { hasta: 4, txt: '3-4' },
  { hasta: 7, txt: '5-7' },
  { hasta: 12, txt: '8-12' },
  { hasta: 99, txt: '16 o más' },
];
const tramo = (n: number) => TRAMOS.findIndex((t) => n <= t.hasta);
// Opciones del simulador: un número de escaños por cada tamaño real, con ejemplos.
const opciones = [...grupos].reverse().map((g) => ({
  n: g.n,
  txt: `${g.n} ${g.n === 1 ? 'escaño' : 'escaños'} · ${g.sitios.slice(0, 3).join(', ')}${g.sitios.length > 3 ? '…' : ''}`,
}));

const LOREG = 'https://www.boe.es/buscar/act.php?id=BOE-A-1985-11672';
const CE = 'https://www.boe.es/buscar/act.php?id=BOE-A-1978-31229';
const art = {
  l96: `${LOREG}#anoventayseis`,
  l162: `${LOREG}#acientosesentaydos`,
  l163: `${LOREG}#acientosesentaytres`,
  l166: `${LOREG}#acientosesentayseis`,
  c68: `${CE}#a68`,
  c69: `${CE}#a69`,
  c99: `${CE}#a99`,
};
// Ejemplo práctico del artículo 163 de la LOREG: 480.000 votos, 8 escaños, 6 candidaturas.
const EJEMPLO = { escanos: 8, votos: [168000, 104000, 72000, 64000, 40000, 32000], blancos: 0 };
const LETRAS = ['A', 'B', 'C', 'D', 'E', 'F'];
// Pasos, en el orden en que pasan las cosas: del voto al Gobierno. El Senado va aparte.
const PASOS = [
  { id: 'tu-voto', n: '1', txt: 'Tu voto' },
  { id: 'tu-provincia', n: '2', txt: 'Tu provincia' },
  { id: 'el-reparto', n: '3', txt: 'El reparto' },
  { id: 'despues', n: '4', txt: 'La investidura' },
];
---
<Base titulo="Cómo se reparten los escaños" seccion="guias" descripcion="Cómo se convierten los votos del 29N en los 350 diputados del Congreso: el voto en blanco, las provincias, el 3 %, la ley D'Hondt con un simulador, la investidura y el Senado.">
  <div class="chd pad gr-top">
    <div class="crumbs gr-crumbs"><a href={HUB.href}>{HUB.nombre}</a> › Cómo se reparten los escaños</div>
    <h1 class="cond">Cómo se reparten los escaños</h1>
    <p class="lead">El 29N no se suman los votos de toda España: cada provincia reparte sus propios diputados. Aquí tienes cómo, paso a paso, con un simulador para probarlo y la ley a un clic.</p>
  </div>

  <div class="pad gr">
    <section class="gr-cifras" aria-label="El 29N en 4 cifras">
      <div><p class="gr-c"><b class="cond">350</b><strong class="cond">diputados</strong></p><span>forman el Congreso.</span><a href={art.l162} target="_blank" rel="noopener">LOREG, art. 162</a></div>
      <div><p class="gr-c"><b class="cond">52</b><strong class="cond">circunscripciones</strong></p><span>las 50 provincias, más Ceuta y Melilla.</span><a href={art.c68} target="_blank" rel="noopener">Constitución, art. 68</a></div>
      <div><p class="gr-c"><b class="cond">3 %</b><strong class="cond">mínimo</strong></p><span>de los votos válidos de la provincia para optar a escaño.</span><a href={art.l163} target="_blank" rel="noopener">LOREG, art. 163</a></div>
      <div><p class="gr-c"><b class="cond">176</b><strong class="cond">diputados</strong></p><span>son la mayoría absoluta, la que se pide en la primera votación de investidura.</span><a href={art.c99} target="_blank" rel="noopener">Constitución, art. 99</a></div>
    </section>

    {/* Los pasos, en orden: cada uno lleva a su sección. Se queda arriba al bajar. */}
    <nav class="gr-pasos" aria-label="Pasos de la guía">
      <ol>
        {PASOS.map((p) => <li><a href={`#${p.id}`}><span>{p.n}</span>{p.txt}</a></li>)}
        <li class="gr-pasos-y"><a href="#senado"><span>+</span>Y el Senado</a></li>
      </ol>
    </nav>

    <section class="gr-sec" id="tu-voto" aria-labelledby="h-tu-voto">
      <div class="gr-h">
        <p class="gr-paso" aria-hidden="true">1</p>
        <div>
          <h2 class="cond" id="h-tu-voto">Tu voto</h2>
          <p>Antes de repartir nada se cuentan los votos válidos: los de cada candidatura y los votos en blanco. El voto en blanco cuenta para el 3 %; el nulo y la abstención, no.</p>
        </div>
      </div>
      <div class="gr-tres">
        <div>
          <h3><span class="gr-ico"><Icono id="sobre" /></span>En blanco</h3>
          <p>Un sobre sin papeleta. La ley lo considera <b>válido</b>: suma a los votos válidos de la provincia, sobre los que se calcula el 3 %. No da escaños a nadie.</p>
          <p class="gr-ef">Sube el mínimo del 3 %. Pruébalo en el simulador, con la casilla «En blanco».</p>
        </div>
        <div>
          <h3><span class="gr-ico"><Icono id="tachada" /></span>Nulo</h3>
          <p>Un sobre con papeletas de varias candidaturas, una papeleta tachada o con algo escrito, o una papeleta que no es la oficial, entre otros casos.</p>
          <p class="gr-ef">No cuenta para el reparto ni para el 3 %.</p>
        </div>
        <div>
          <h3><span class="gr-ico"><Icono id="urna" /></span>Abstención</h3>
          <p>No votar.</p>
          <p class="gr-ef">No cuenta para el reparto ni para el 3 %.</p>
        </div>
      </div>
      <p class="gr-nota"><a href={art.l96} target="_blank" rel="noopener">LOREG, art. 96</a> (voto nulo y en blanco) y <a href={art.l163} target="_blank" rel="noopener">art. 163</a> (el 3 % se calcula sobre los votos válidos emitidos en la circunscripción).</p>
    </section>

    <section class="gr-sec" id="tu-provincia" aria-labelledby="h-tu-provincia">
      <div class="gr-h">
        <p class="gr-paso" aria-hidden="true">2</p>
        <div>
          <h2 class="cond" id="h-tu-provincia">Tu provincia</h2>
          <p>Tu voto solo cuenta en tu provincia, y cada una elige un número fijo de diputados. Todas parten de 2 (Ceuta y Melilla, de 1) y el resto se reparte según la población. Por eso Madrid elige 38 y Soria, 2.</p>
        </div>
      </div>
      <div class="gr-prov" data-vistas>
        <div class="gr-prov-bar">
          <h3>Diputados que elige cada circunscripción el 29N</h3>
          <div class="vista gr-vista" role="group" aria-label="Ver como">
            <button type="button" data-v="mapa" aria-pressed="true">Mapa</button>
            <button type="button" data-v="lista" aria-pressed="false">Lista</button>
          </div>
        </div>
        <div class="gr-mapa-w" data-panel="mapa">
          <ol class="gr-mapa" aria-label="Mapa de casillas: una por circunscripción, en su posición aproximada">
            {CIRCUNSCRIPCIONES.map((c) => (
              <li class={`t${tramo(c.diputados)}`} style={`grid-column:${c.x + 1};grid-row:${c.y + 1}`} title={`${nombre(c.nombre)}: ${c.diputados}`}>
                <span class="gr-mn">{c.corto}</span>
                <b class="cond">{c.diputados}</b>
                <span class="sr-only">{` ${c.diputados === 1 ? 'diputado' : 'diputados'}`}</span>
              </li>
            ))}
          </ol>
          <ul class="gr-ley" aria-label="Leyenda">
            {TRAMOS.map((t, i) => <li><i class={`t${i}`}></i>{t.txt}</li>)}
          </ul>
          <p class="gr-nota">Casillas en su posición aproximada; Canarias, abajo a la derecha.</p>
        </div>
        <ul class="gr-lista" data-panel="lista" hidden>
          {grupos.map((g) => (
            <li>
              <span class="gr-n cond">{g.n}</span>
              <span class="gr-dots" aria-hidden="true">{Array.from({ length: g.n }, () => <i />)}</span>
              <span class="gr-sitios">{g.sitios.join(' · ')}</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="gr-nota">Cada provincia tiene 2 diputados de partida, Ceuta y Melilla 1 cada una, y los 248 restantes se reparten según la población (<a href={art.l162} target="_blank" rel="noopener">LOREG, art. 162</a>). Las cifras son las del anexo del <a href={RD_CONVOCATORIA.url} target="_blank" rel="noopener">Real Decreto 806/2026</a> de convocatoria.</p>
    </section>

    <section class="gr-sec" id="el-reparto" aria-labelledby="h-el-reparto">
      <div class="gr-h">
        <p class="gr-paso" aria-hidden="true">3</p>
        <div>
          <h2 class="cond" id="h-el-reparto">El reparto</h2>
          <p>Dentro de cada provincia, los escaños se reparten con el método que la ley describe en el artículo 163 de la LOREG, conocido como <b>ley D'Hondt</b>. Cambia los votos o los escaños y mira qué pasa. Empieza con el ejemplo que trae la propia ley.</p>
        </div>
      </div>

      <div class="sim" data-sim data-ejemplo={JSON.stringify(EJEMPLO)}>
        <form class="sim-ctl" aria-label="Datos de la provincia del ejemplo" onsubmit="return false">
          <label class="sim-esc">
            <span>Escaños en juego</span>
            <select name="escanos">
              {opciones.map((o) => <option value={o.n} selected={o.n === EJEMPLO.escanos}>{o.txt}</option>)}
            </select>
          </label>
          <fieldset>
            <legend>Votos de cada candidatura</legend>
            {LETRAS.map((l, i) => (
              <label class="sim-fila" data-i={i}>
                <span class={`sim-l p${i}`}>{l}</span>
                <input type="range" min="0" max="250000" step="1000" value={EJEMPLO.votos[i]} aria-label={`Votos de ${l}`} data-rango />
                <input type="number" min="0" step="1000" value={EJEMPLO.votos[i]} aria-label={`Votos de ${l}, en cifra`} data-cifra />
              </label>
            ))}
            <label class="sim-fila sim-blanco">
              <span class="sim-l pb" aria-hidden="true"></span>
              <span class="sim-bl">En blanco</span>
              <input type="number" min="0" step="1000" value={EJEMPLO.blancos} name="blancos" aria-label="Votos en blanco" />
            </label>
          </fieldset>
          <button type="button" class="sim-reset" data-ejemplo-btn>Volver al ejemplo de la ley</button>
        </form>

        <div class="sim-out">
          <div class="sim-paso">
            <h3><span>1</span> ¿Quién pasa del 3 %?</h3>
            <p data-umbral-txt></p>
            <ul class="sim-umbral" data-umbral></ul>
          </div>
          <div class="sim-paso">
            <h3><span>2</span> Se dividen los votos entre 1, 2, 3…</h3>
            <p>Hasta tantas veces como escaños hay. Los escaños van a los cocientes más altos, de mayor a menor; el número de cada casilla marcada es el orden en que se adjudica.</p>
            <div class="sim-tabla-w"><table class="sim-tabla" data-tabla></table></div>
          </div>
          <div class="sim-paso">
            <h3><span>3</span> Resultado</h3>
            <div class="sim-esc-res" data-res aria-hidden="true"></div>
            <p class="sim-resumen" data-resumen aria-live="polite"></p>
            <div class="sim-ultimo" data-ultimo></div>
          </div>
        </div>
      </div>
      <p class="gr-nota">Si 2 cocientes empatan, el escaño es para la candidatura con más votos en total; si también empatan en votos, la primera vez se sortea. En Ceuta y Melilla, que eligen 1 diputado cada una, gana la candidatura con más votos. <a href={art.l163} target="_blank" rel="noopener">LOREG, art. 163</a></p>
    </section>

    <section class="gr-sec" id="despues" aria-labelledby="h-despues">
      <div class="gr-h">
        <p class="gr-paso" aria-hidden="true">4</p>
        <div>
          <h2 class="cond" id="h-despues">La investidura</h2>
          <p>Votar no elige directamente a quien preside el Gobierno: lo elige el Congreso que sale de las urnas.</p>
        </div>
      </div>
      <ol class="gr-linea">
        <li><b>23 de diciembre, 10:00 h</b><span>Se constituyen el nuevo Congreso y el nuevo Senado.</span><a href={RD_CONVOCATORIA.url} target="_blank" rel="noopener">Real Decreto 806/2026, art. 5</a></li>
        <li><b>Propuesta de candidato</b><span>Tras consultar a los grupos, el rey propone un candidato, que presenta su programa al Congreso y pide su confianza.</span><a href={art.c99} target="_blank" rel="noopener">Constitución, art. 99</a></li>
        <li><b>Primera votación</b><span>Necesita la mayoría absoluta: 176 síes.</span></li>
        <li><b>48 horas después</b><span>Si no la logra, basta la mayoría simple: más síes que noes.</span></li>
        <li><b>2 meses después</b><span>Si pasados 2 meses desde la primera votación nadie ha sido investido, se disuelven las Cortes y se repiten las elecciones.</span></li>
      </ol>
    </section>

    <section class="gr-sec" id="senado" aria-labelledby="h-senado">
      <div class="gr-h">
        <p class="gr-paso gr-paso-y" aria-hidden="true">+</p>
        <div>
          <h2 class="cond" id="h-senado">Y el Senado</h2>
          <p>El mismo día se vota también el Senado, con otra papeleta y otras reglas: aquí se vota a personas, no a listas.</p>
        </div>
      </div>
      <div class="gr-tres">
        <div>
          <h3><span class="gr-ico"><Icono id="escanos" /></span>Cuántos se eligen</h3>
          <p>Cada provincia elige 4 senadores. En las islas, Gran Canaria, Mallorca y Tenerife eligen 3, y cada una de las demás islas con Cabildo o Consejo, 1. Ceuta y Melilla eligen 2 cada una.</p>
        </div>
        <div>
          <h3><span class="gr-ico"><Icono id="papeleta" /></span>Cómo se vota</h3>
          <p>Marcas a los candidatos que quieras, de cualquier partido: hasta 3 en las provincias; hasta 2 en Gran Canaria, Mallorca, Tenerife, Ceuta y Melilla, y 1 en el resto de islas. Si marcas más, el voto es nulo.</p>
        </div>
        <div>
          <h3><span class="gr-ico"><Icono id="podio" /></span>Quién sale</h3>
          <p>Los candidatos más votados, uno a uno, hasta cubrir los puestos. Además, cada comunidad autónoma designa 1 senador, y 1 más por cada millón de habitantes.</p>
        </div>
      </div>
      <p class="gr-nota"><a href={art.c69} target="_blank" rel="noopener">Constitución, art. 69</a>; <a href={art.l166} target="_blank" rel="noopener">LOREG, art. 166</a> y <a href={art.l96} target="_blank" rel="noopener">art. 96</a>.</p>
    </section>

    <section class="gr-fuentes" aria-labelledby="h-fuentes">
      <h2 id="h-fuentes">Fuentes</h2>
      <ul>
        <li><a href={RD_CONVOCATORIA.url} target="_blank" rel="noopener">{RD_CONVOCATORIA.nombre}</a> (BOE, 6 de octubre de 2026): diputados por circunscripción y fecha de constitución de las Cámaras.</li>
        <li><a href={LOREG} target="_blank" rel="noopener">Ley Orgánica 5/1985, del Régimen Electoral General</a>: artículos 96, 162, 163 y 166.</li>
        <li><a href={CE} target="_blank" rel="noopener">Constitución Española</a>: artículos 68, 69 y 99.</li>
      </ul>
      <p>Las candidaturas del simulador son inventadas y no reflejan ningún resultado real ni previsto.</p>
    </section>
  </div>
</Base>

<script>
  // Mapa o lista de provincias.
  const vistas = document.querySelector<HTMLElement>('[data-vistas]');
  vistas?.querySelectorAll<HTMLButtonElement>('[data-v]').forEach((b) =>
    b.addEventListener('click', () => {
      vistas.classList.add('cambiada'); // solo a partir del primer cambio: al cargar, sin fundido
      vistas.querySelectorAll<HTMLButtonElement>('[data-v]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      vistas.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.v));
    }),
  );

  // Pasos: marca el de la sección que se está leyendo; al pulsar, baja con suavidad.
  const nav = document.querySelector<HTMLElement>('.gr-pasos');
  if (nav) {
    const enlaces = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const secciones = enlaces.map((a) => document.getElementById(a.hash.slice(1))).filter((s): s is HTMLElement => !!s);
    const marcar = () => {
      const corte = innerHeight * 0.35;
      let actual = '';
      for (const s of secciones) if (s.getBoundingClientRect().top <= corte) actual = s.id;
      enlaces.forEach((a) => (a.hash.slice(1) === actual ? a.setAttribute('aria-current', 'step') : a.removeAttribute('aria-current')));
      nav.classList.toggle('pegada', nav.getBoundingClientRect().top <= parseFloat(getComputedStyle(nav).top) + 1 && scrollY > 0);
      const activo = nav.querySelector<HTMLElement>('[aria-current]');
      if (activo && nav.scrollWidth > nav.clientWidth) nav.scrollTo({ left: nav.scrollLeft + activo.getBoundingClientRect().left - nav.getBoundingClientRect().left - 16 });
    };
    addEventListener('scroll', marcar, { passive: true });
    marcar();
    // Altura de la barra, para que el título de cada sección no quede debajo al saltar.
    const medir = () => document.documentElement.style.setProperty('--pasos-h', `${nav.offsetHeight}px`);
    medir();
    new ResizeObserver(medir).observe(nav);
    for (const a of enlaces)
      a.addEventListener('click', (e) => {
        const destino = document.getElementById(a.hash.slice(1));
        if (!destino) return;
        e.preventDefault();
        destino.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        history.pushState(null, '', a.hash);
      });
  }

  // Simulador del reparto D'Hondt (art. 163 LOREG). Sin dependencias; se recalcula con cada cambio.
  const LETRAS = ['A', 'B', 'C', 'D', 'E', 'F'];
  const fmt = new Intl.NumberFormat('es-ES');
  const fmtQ = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 0 });
  const sim = document.querySelector<HTMLElement>('[data-sim]');
  if (sim) {
    const ejemplo = JSON.parse(sim.dataset.ejemplo!) as { escanos: number; votos: number[]; blancos: number };
    const selEsc = sim.querySelector<HTMLSelectElement>('select[name="escanos"]')!;
    const blancos = sim.querySelector<HTMLInputElement>('input[name="blancos"]')!;
    const filas = [...sim.querySelectorAll<HTMLElement>('.sim-fila[data-i]')];
    const $ = (s: string) => sim.querySelector<HTMLElement>(s)!;
    const num = (v: string) => Math.max(0, Math.floor(Number(v) || 0));
    const leer = () => filas.map((f) => num(f.querySelector<HTMLInputElement>('[data-cifra]')!.value));
    const fichaP = (i: number) => `<span class="sim-l p${i}">${LETRAS[i]}</span>`;

    const pintar = () => {
      const votos = leer();
      const esc = Number(selEsc.value);
      const bl = num(blancos.value);
      const validos = votos.reduce((a, b) => a + b, 0) + bl;
      const minimo = validos * 0.03;
      const presentes = votos.map((_, i) => i).filter((i) => votos[i] > 0);
      const entran = presentes.filter((i) => votos[i] >= minimo);

      // 1) Umbral
      $('[data-umbral-txt]').innerHTML = validos
        ? `Votos válidos: <b>${fmt.format(validos)}</b>${bl ? ` (incluidos ${fmt.format(bl)} en blanco)` : ''}. El 3 % son <b>${fmt.format(Math.ceil(minimo))}</b> votos: la línea vertical.`
        : 'Pon algún voto para empezar.';
      const maxV = Math.max(1, ...votos);
      $('[data-umbral]').innerHTML = presentes
        .map((i) => {
          const ok = votos[i] >= minimo;
          return `<li class="${ok ? '' : 'fuera'}">${fichaP(i)}<span class="sim-bar"><i class="p${i}" style="width:${(votos[i] / maxV) * 100}%"></i><em style="left:${(minimo / maxV) * 100}%" aria-hidden="true"></em></span><span class="sim-v">${fmt.format(votos[i])}<small>${((votos[i] / validos) * 100).toLocaleString('es-ES', { maximumFractionDigits: 1 })} %${ok ? '' : ' · fuera'}</small></span></li>`;
        })
        .join('');

      // 2) Cocientes
      const cs: { i: number; d: number; q: number }[] = [];
      for (const i of entran) for (let d = 1; d <= esc; d++) cs.push({ i, d, q: votos[i] / d });
      // Mayor cociente primero; si empatan, más votos totales (art. 163.1.d); si también, el primero (sorteo).
      cs.sort((a, b) => b.q - a.q || votos[b.i] - votos[a.i] || a.i - b.i);
      const ganan = cs.slice(0, esc);
      const orden = new Map(ganan.map((c, k) => [`${c.i}-${c.d}`, k + 1]));
      const ultimo = ganan[ganan.length - 1];
      const escanos = LETRAS.map((_, i) => ganan.filter((c) => c.i === i).length);
      // El que se quedó más cerca: el primer cociente sin escaño de otra candidatura.
      const rival = cs.slice(esc).find((c) => !ultimo || c.i !== ultimo.i);

      const cols = Array.from({ length: esc }, (_, k) => k + 1);
      $('[data-tabla]').innerHTML = entran.length
        ? `<thead><tr><th scope="col">Entre</th>${cols.map((d) => `<th scope="col">${d}</th>`).join('')}</tr></thead><tbody>${entran
            .map(
              (i) =>
                `<tr><th scope="row">${fichaP(i)}</th>${cols
                  .map((d) => {
                    const k = orden.get(`${i}-${d}`);
                    const esUlt = ultimo && ultimo.i === i && ultimo.d === d;
                    const esRival = rival && rival.i === i && rival.d === d;
                    const cls = [k ? 'gana' : '', esUlt ? 'ult' : '', esRival ? 'riv' : ''].filter(Boolean).join(' ');
                    return `<td class="${cls}">${k ? `<sup>${k}.º</sup>` : ''}${fmtQ.format(votos[i] / d)}</td>`;
                  })
                  .join('')}</tr>`,
            )
            .join('')}</tbody>`
        : '';

      // 3) Resultado
      $('[data-res]').innerHTML = ganan.map((c, k) => `<span class="sim-l p${c.i}${k === ganan.length - 1 ? ' ult' : ''}">${LETRAS[c.i]}</span>`).join('');
      const conEscano = escanos.map((n, i) => ({ n, i })).filter((x) => x.n > 0).sort((a, b) => b.n - a.n || a.i - b.i);
      const sin = presentes.filter((i) => !escanos[i]);
      $('[data-resumen]').innerHTML = ganan.length
        ? `${conEscano.map((x) => `<b>${LETRAS[x.i]}</b> ${x.n} ${x.n === 1 ? 'escaño' : 'escaños'}`).join(', ')}.${sin.length ? ` Sin escaño: ${sin.map((i) => `${LETRAS[i]} (${fmt.format(votos[i])} votos)`).join(', ')}.` : ''}`
        : '';

      // El último escaño: cuántos votos más necesitaba el rival para quitárselo (con el resto de votos igual).
      let txt = '';
      if (ultimo && rival && esc > 1) {
        const s = escanos[rival.i];
        const N = votos[ultimo.i] * (s + 1);
        const D = ultimo.d;
        let y = Math.floor(N / D) + 1;
        if (N % D === 0 && N / D > votos[ultimo.i]) y = N / D; // empate de cocientes: gana quien tiene más votos
        const faltan = y - votos[rival.i];
        txt = `<p><b>El último escaño</b>, el ${esc}.º, fue para <b>${LETRAS[ultimo.i]}</b> con un cociente de ${fmtQ.format(ultimo.q)}. El cociente más alto que se quedó fuera era de <b>${LETRAS[rival.i]}</b>: ${fmtQ.format(rival.q)}. Con <b>${fmt.format(faltan)} votos más</b>, y lo demás igual, ese escaño habría sido para ${LETRAS[rival.i]}.</p>`;
      }
      const casi = presentes.filter((i) => votos[i] < minimo).map((i) => ({ i, f: Math.ceil((minimo - votos[i]) / 0.97) }));
      if (casi.length)
        txt += `<p>${casi.map((c) => `<b>${LETRAS[c.i]}</b> no llega al 3 %: le faltan ${fmt.format(c.f)} votos para entrar en el reparto`).join('; ')}.</p>`;
      $('[data-ultimo]').innerHTML = txt;
      $('[data-ultimo]').hidden = !txt;
    };

    // Rango y cifra van sincronizados; la cifra puede pasar del tope del rango.
    for (const f of filas) {
      const r = f.querySelector<HTMLInputElement>('[data-rango]')!;
      const c = f.querySelector<HTMLInputElement>('[data-cifra]')!;
      r.addEventListener('input', () => { c.value = r.value; pintar(); });
      c.addEventListener('input', () => { const v = num(c.value); if (v > Number(r.max)) r.max = String(v); r.value = String(v); pintar(); });
    }
    selEsc.addEventListener('change', pintar);
    blancos.addEventListener('input', pintar);
    sim.querySelector('[data-ejemplo-btn]')!.addEventListener('click', () => {
      selEsc.value = String(ejemplo.escanos);
      blancos.value = String(ejemplo.blancos);
      filas.forEach((f, i) => {
        const r = f.querySelector<HTMLInputElement>('[data-rango]')!;
        r.max = '250000';
        r.value = f.querySelector<HTMLInputElement>('[data-cifra]')!.value = String(ejemplo.votos[i]);
      });
      pintar();
    });
    pintar();
  }
</script>

<style>
  /* Tonos de la guía: crema y tostado en vez de negro; el negro queda para el texto y los detalles. */
  .gr-top, .gr { --tost: #E3D4A8; --tost2: #C9B47E; --tost3: #9C8650; --tost4: #6B5A2E }
