---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada" indexar={false} noindex>
  <div class="chd pad" style="padding-bottom:var(--sec)">
    <h1 class="cond">Esta página no está en la gaveta</h1>
    <p class="lead">Puede que la dirección haya cambiado. Prueba desde el mapa o con el buscador.</p>
    <div class="acts-row"><a class="btn ink" href="/">Ir al mapa <span class="arrow">→</span></a><a class="btn" href="/buscar/">Buscar</a></div>
  </div>
</Base>
